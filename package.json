{
  "name": "nimiq-gasless",
  "private": true,
  "license": "MIT",
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "pnpm -r --filter ./sdk --filter ./relay run build",
    "build:sdk": "pnpm --filter @nimiq/gasless-sdk build",
    "typecheck": "pnpm build:sdk && pnpm -r run typecheck",
    "test": "pnpm build:sdk && pnpm -r run test",
    "test:integration": "pnpm build:sdk && pnpm --filter @nimiq/gasless-relay test:integration"
  }
}
