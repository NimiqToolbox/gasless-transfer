    "pino": "10.3.1",
    "prom-client": "15.1.3",
    "viem": "2.56.9",
    "zod": "4.6.6"
  },
  "devDependencies": {
    "@types/better-sqlite3": "7.6.13",
    "@types/node": "24.13.6",
    "typescript": "5.9.3",
    "vite": "8.3.5",
    "vitest": "4.1.12"
  }
}
