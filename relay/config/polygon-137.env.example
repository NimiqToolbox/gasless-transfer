# Example production relay policy with the default limits spelled out. Copy outside source control, supply
# operator-owned paths and set the limits deliberately.
# These values configure service policy only; they do not deploy, fund, or change client pins.
# compose.production.yaml sets the paths and listeners itself, and its values win; they matter for native operation.
RELAY_DEPLOYMENT_FILE=/app/deployments/137.json
RELAY_TOKEN_PINS_FILE=/app/config/token-pins.polygon-137.json
RELAY_GAS_TABLE_FILE=/app/config/gasTable.json
RELAY_DB_PATH=/data/relay.sqlite
RELAY_PRIVATE_KEY_FILE=/run/secrets/relay_key
# Set two independent HTTPS providers. Empty is deliberately invalid. Each must serve the state of older blocks
# (an archive node, or one keeping the relay's history window: relay/README.md, "RPC history"); startup refuses
# one that does not, and RELAY_RPC_HISTORY_CHECK_SECONDS (default 600) repeats the check.
RELAY_RPC_URLS=
# Chainlink POL/USD is mandatory. Oracle failure stops pricing; no static price is used.
RELAY_POLUSD_FEED=default
# Conservative lifetime gross exposure, INCLUDING successful calls and pending/cancel/filler gas.
# Raising this ceiling is a deliberate operator expenditure authorization; top-ups do not reset it.
RELAY_TOTAL_GAS_BUDGET_POL=1
RELAY_MIN_POL_BALANCE=1
RELAY_MAX_IN_FLIGHT=4
# One queued or in-flight request per sender (sequential intent nonces).
RELAY_MAX_QUEUED=100
RELAY_PREFLIGHT_COOLDOWN_SECONDS=600
RELAY_TOKEN_DOMAIN_CHECK_SECONDS=60
RELAY_OPS_HOST=127.0.0.1
RELAY_OPS_PORT=9464
# Keep the operational listener private. A collector in another container needs an isolated private network
# and an explicit listener override; do not publish its port publicly.
